{
  "expo": {
    "name": "restaurante-app",
    "slug": "restaurante-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.michelsanchez.restauranteapp"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar"
    ]
  }
}
